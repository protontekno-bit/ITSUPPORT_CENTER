# ==============================================================================
# .gitignore for IT Support Center (.NET 8 + Standalone Tools Suite)
# ==============================================================================

# Build & Intermediate Output
[Bb]in/
[Oo]bj/
*.pdb
*.dll
*.exe.config

# Large Compiled Binaries & Release Packages (Generate via build script)
ITSupportCenter.exe
dist/
installers/*.exe

# Visual Studio & IDE Cache
.vs/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates

# Windows System Files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Temporary / Scratch Files
*.tmp
*.temp
*.log
scratch/

# Security & Data Leak Prevention (Anti-Data Leak)
*.key
*.pem
*.pfx
*.p12
*.cer
*.crt
*.env
*.env.*
*.bak
*.old
*.swp

# Exported User Reports & Sensitive Network Dumps
*.html
!src/**/*.html
*.xml
!src/**/*.xml
!**/*.csproj
!**/*.manifest
battery_report.html
service_report_*.html
wifi_profiles_*.xml
reports/
backups/
backup/
UserProfiles/
